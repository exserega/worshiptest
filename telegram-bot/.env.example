# Telegram Bot Configuration
# Скопируйте этот файл как .env и заполните реальными значениями

# Telegram Bot Token (получите от @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Firebase Service Account
# Путь к JSON файлу с ключом Firebase Admin SDK
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Web App URL
# URL вашего PWA приложения
WEB_APP_URL=https://agapeworship.asia

# Environment (development / production)
NODE_ENV=development

# Port для webhook (опционально, для продакшена)
# PORT=3000

# Webhook URL (опционально, для продакшена)
# WEBHOOK_URL=https://your-domain.com/webhook
